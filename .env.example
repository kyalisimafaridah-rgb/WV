# Server
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Router network security. Keep false in hosted production.
ALLOW_PRIVATE_ROUTER_HOSTS=false
ROUTER_TLS_REJECT_UNAUTHORIZED=true

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Encryption key for router credentials (32 bytes hex or base64)
ENCRYPTION_KEY=your-32-byte-hex-encryption-key-here

# Trial days
TRIAL_DAYS=14

# Admin secret
ADMIN_SECRET=change-me-to-a-long-random-string

SUBSCRIPTION_PRICE_UGX=20000
SUBSCRIPTION_PERIOD_DAYS=30
MOMO_SMS_WEBHOOK_SECRET=change-me-to-a-long-random-string

# Public business details. Replace before launch.
BUSINESS_NAME=WiFi Voucher
BUSINESS_EMAIL=
BUSINESS_PHONE=
BUSINESS_ADDRESS=
